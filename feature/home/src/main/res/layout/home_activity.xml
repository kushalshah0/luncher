<?xml version="1.0" encoding="utf-8"?>
<!-- Merged into the window's content FrameLayout: one view level less to lay out and draw. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The top bar stays in place; the tiles scroll in the space below it. Left to right in every
         language: where the clock, the settings entry and the tiles go is for settings to decide,
         not the language. So a right-to-left language mirrors only the settings panels, and a
         future carousel (a RecyclerView, say) doesn't mirror either. Texts still read in their
         own direction, lined up at the left (Theme.Luncher). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layoutDirection="ltr"
        android:orientation="vertical">

        <!-- The clock at one edge, the settings entry (later e.g. status indicators too) at the
             other: which is where, TopBarView decides from the appearance, and moves them. Not
             focusable itself: D-pad Up from the tiles reaches only what's focusable in it. While
             the user moves an app, the mode's title and key hint take the place of the clock and
             the settings entry. -->
        <com.luncher.launcher.home.TopBarView
            android:id="@+id/home_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/screen_padding_horizontal"
            android:paddingTop="@dimen/home_top_bar_padding_top"
            android:paddingRight="@dimen/screen_padding_horizontal">

            <!-- Time and date share a baseline, side by side in the order the appearance gives. -->
            <com.luncher.launcher.home.ClockView
                android:id="@+id/home_clock"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <com.luncher.launcher.home.OutlinedTextView
                    android:id="@+id/home_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/home_time_text" />

                <com.luncher.launcher.home.OutlinedTextView
                    android:id="@+id/home_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableLeft="@drawable/home_divider"
                    android:drawablePadding="@dimen/home_clock_gap"
                    android:letterSpacing="0.15"
                    android:textAllCaps="true"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/home_date_text" />
            </com.luncher.launcher.home.ClockView>

            <!-- As tall as the settings entry it replaces, so the tiles below stay where they are.
                 What the hint leaves of the bar: where a language's title and hint don't both
                 fit (a narrow screen, large text), the title ends in "…", never the hint. -->
            <com.luncher.launcher.home.OutlinedTextView
                android:id="@+id/home_move_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:minHeight="@dimen/home_settings_size"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="@string/home_move_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/home_time_text"
                android:visibility="gone" />

            <com.luncher.launcher.home.OutlinedTextView
                android:id="@+id/home_move_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="@string/home_move_hint"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/home_move_hint_text"
                android:visibility="gone" />

            <!-- Status pills (StatusIndicators): network, free RAM, USB, VPN. Glass look, not focusable. -->
            <LinearLayout
                android:id="@+id/home_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/home_status_network"
                    style="@style/HomeStatusPill.Clickable"
                    android:drawableLeft="@drawable/home_ic_wifi" />
                <TextView
                    android:id="@+id/home_status_ram"
                    style="@style/HomeStatusPill.Clickable"
                    android:drawableLeft="@drawable/home_ic_memory" />
                <TextView
                    android:id="@+id/home_status_usb"
                    style="@style/HomeStatusPill.Icon"
                    android:drawableLeft="@drawable/home_ic_usb"
                    android:visibility="gone" />
                <!-- Only while a VPN is connected, e.g. WireGuard's tunnel. -->
                <TextView
                    android:id="@+id/home_status_vpn"
                    style="@style/HomeStatusPill.Icon"
                    android:contentDescription="@string/home_status_vpn"
                    android:drawableLeft="@drawable/home_ic_vpn"
                    android:visibility="gone" />

                <!-- Opens the Bluetooth menu; dimmed while nothing is connected (StatusIndicators). -->
                <TextView
                    android:id="@+id/home_status_bluetooth"
                    style="@style/HomeStatusPill.Icon"
                    android:contentDescription="@string/home_status_bluetooth"
                    android:drawableLeft="@drawable/home_ic_bluetooth"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Opens the settings panel (NETTV fork: a pill like the status ones, gear and "Settings").
                 Focusable, so Up from the first row of tiles reaches it; it dips while OK is held. -->
            <TextView
                android:id="@+id/home_settings"
                style="@style/HomeStatusPill.Clickable"
                android:drawableLeft="@drawable/home_ic_settings"
                android:text="@string/home_settings" />
        </com.luncher.launcher.home.TopBarView>

        <!-- Tiles may zoom past the padding, and scroll through it up to the top bar. -->
        <com.luncher.launcher.home.AppTilesView
            android:id="@+id/home_apps"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingLeft="@dimen/screen_padding_horizontal"
            android:paddingTop="@dimen/home_tiles_padding_top"
            android:paddingRight="@dimen/screen_padding_horizontal"
            android:paddingBottom="@dimen/home_padding_vertical" />
    </LinearLayout>

    <com.luncher.launcher.home.OutlinedTextView
        android:id="@+id/home_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/home_no_apps"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/home_empty_text"
        android:visibility="gone" />

</merge>
