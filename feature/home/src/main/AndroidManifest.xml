<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The home screen's status row (StatusIndicators): network type and WiFi signal. Normal
         permissions, granted at install. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- The Wi-Fi picker (WifiPicker): connect to a network, and list them (scan results need the
         location permission from API 23; asked for when the picker opens). -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- The RAM pill's clean-up: stops other apps' background processes. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- The Bluetooth pill: whether a device is connected. A runtime permission from API 31, not
         asked for: without it the pill stays hidden. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- The VPN menu (VpnMenu): turns WireGuard's tunnel off. WireGuard's own permission, a
         dangerous one, asked for the first time; and WireGuard visible (API 30+), to open it. -->
    <uses-permission android:name="com.wireguard.android.permission.CONTROL_TUNNELS" />

    <queries>
        <package android:name="com.wireguard.android" />
    </queries>

    <!-- As the app declares it, so the JVM tests, which have no app manifest, follow a
         right-to-left language as the app does. -->
    <application android:supportsRtl="true">

        <!-- How the home screen behaves; what makes it the device's home screen and a TV app (its
             intent filters) is the app's to declare, in its manifest, which the build merges with
             this one. adjustNothing: the keyboard the rename dialog opens doesn't slide the home
             screen up behind it to keep the focused tile in sight; the dialog moves instead
             (NameDialog). -->
        <activity
            android:name=".HomeActivity"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.Luncher"
            android:windowSoftInputMode="adjustNothing" />
    </application>

</manifest>
